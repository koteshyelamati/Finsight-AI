# Copy this file to .env and fill in your values.

# ── LLM Providers ────────────────────────────────────────────────────────────
# Gemini is the PRIMARY provider. Set GEMINI_API_KEY to enable it.
# Anthropic is the FALLBACK provider. Set ANTHROPIC_API_KEY to enable it.
# At least one key must be present; both enables automatic provider failover.
#
# Resilience: if all configured providers fail (billing, quota, auth), the RAG
# agent falls back to returning raw retrieved document excerpts so the API
# never returns 500 for a provider outage.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional — Anthropic fallback (used when Gemini is unavailable or errors)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server
FINSIGHT_HOST=0.0.0.0
FINSIGHT_PORT=8000

# Dashboard
FINSIGHT_API_URL=http://localhost:8000/api/v1

# PostgreSQL (optional — for persistent message/eval storage)
DATABASE_URL=postgresql://user:password@localhost:5432/finsight

# ChromaDB (optional — override default ./data/chroma_db path)
CHROMA_PERSIST_DIR=./data/chroma_db

# Logging
LOG_LEVEL=INFO
