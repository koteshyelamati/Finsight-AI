# Copy this file to .env and fill in your values.

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
FINSIGHT_HOST=0.0.0.0
FINSIGHT_PORT=8000

# Dashboard
FINSIGHT_API_URL=http://localhost:8000/api/v1

# PostgreSQL (optional — for persistent message/eval storage)
DATABASE_URL=postgresql://user:password@localhost:5432/finsight

# ChromaDB (optional — override default ./data/chroma_db path)
CHROMA_PERSIST_DIR=./data/chroma_db

# Logging
LOG_LEVEL=INFO
